{
  "name": "@phinnpeng/workreport",
  "version": "0.1.0",
  "description": "Local-first work report CLI, designed to be driven by AI agents",
  "type": "module",
  "license": "MIT",
  "author": "PhinnPeng",
  "bin": {
    "workreport": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0 <23 || >=23.4.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "npm run build && node scripts/demo.mjs",
    "ci:paths": "node scripts/ci-paths.mjs",
    "ci:global": "node scripts/ci-global-install.mjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "env-paths": "^4.0.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.13.6",
    "eslint": "^9.39.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.10"
  }
}
